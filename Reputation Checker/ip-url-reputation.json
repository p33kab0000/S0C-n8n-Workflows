      "id": "e142050d-4eb2-48ea-80c3-17960b62968e",
      "name": "VirusTotal: Get report",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        -1344,
        160
      ],
      "typeVersion": 4.1
    },
    {
      "parameters": {},
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.2,
      "position": [
        -1120,
        64
      ],
      "id": "444a0d85-3b75-494a-a79f-5f9cb8af39a5",
      "name": "Merge"
    },
    {
      "parameters": {
        "jsCode": "const vtReport = $('VirusTotal: Get report').first().json;\nconst urlscanData = $input.first().json;\nconst original = $('Is it URL or IP').first().json;\n\n// ---------- 1. VT Processing ----------\nfunction processVT(vtReportJson) {\n    const attrs = vtReportJson?.data?.attributes || {};\n    const stats = attrs.last_analysis_stats || attrs.stats || null;\n    const results = attrs.last_analysis_results || attrs.results || {};\n\n    if (!stats) return { available: false, score: null, malicious: null, suspicious: 0, harmless: 0, undetected: 0, total: 0, results: {} };\n\n    const vtMalicious = stats.malicious || 0;\n    const vtSuspicious = stats.suspicious || 0;\n    const vtHarmless = stats.harmless || 0;\n    const vtUndetected = stats.undetected || 0;\n    const total = vtMalicious + vtSuspicious + vtHarmless + vtUndetected;\n    const score = total > 0 ? Math.min(Math.round((vtMalicious / total) * 100), 100) : 0;\n\n    // Extract the URL hash from the analysis ID\n    const analysisId = vtReport?.data?.id || '';\n    // format: u-<urlhash>-<timestamp>\n    const vtUrlHash = analysisId.startsWith('u-')\n        ? analysisId.split('-').slice(1, -1).join('-')\n        : '';\n\n    const vt_gui_url = vtUrlHash\n        ? `https://www.virustotal.com/gui/url/${vtUrlHash}`\n        : '';\n\n    return {\n        available: true,\n        score,\n        malicious: vtMalicious > 0,\n        vtMalicious,\n        vt_gui_url,\n        vtSuspicious,\n        vtHarmless,\n        vtUndetected,\n        total,\n        results,\n    };\n}\n\n// ---------- 2. URLScan Processing ----------\nfunction processURLScan(urlscanJson) {\n    // Guard against undefined input entirely\n    if (!urlscanJson || urlscanJson?.errorMessage) {\n        return {\n            available: false,\n            score: null,\n            malicious: null,\n            error: urlscanJson?.errorDescription || 'URLScan unavailable'\n        };\n    }\n\n    const verdicts = urlscanJson?.verdicts;\n    if (!verdicts) {\n        return { available: false, score: null, malicious: null, error: 'No verdicts returned' };\n    }\n\n    const overall = verdicts.overall || {};\n    const engines = verdicts.engines || {};\n    const score = Math.min(Math.max(overall.score || 0, engines.score || 0), 100);\n    const malicious = overall.malicious === true || engines.malicious === true;\n\n    return { available: true, score, malicious, error: null };\n}\n\n// ---------- 3. High-Rep Vendor Check ----------\nfunction checkHighRepVendors(vtResults) {\n    const reliableVendors = [\n        'Kaspersky', 'BitDefender', 'ESET', 'Sophos',\n        'Emsisoft', 'G-Data', 'Webroot', 'Netcraft',\n        'Forcepoint ThreatSeeker', 'Google Safebrowsing'\n    ];\n\n    return reliableVendors.filter(v =>\n        vtResults[v] !== undefined && vtResults[v]?.category === 'malicious'\n    );\n}\n\n// ---------- 4. Source-Aware Hybrid Scoring ----------\nfunction computeHybridScore(vt, us) {\n    // Both unavailable\n    if (!vt.available && !us.available) {\n        return { score: 0, method: 'NO_DATA (both sources unavailable - manual review required)' };\n    }\n\n    // VT only\n    if (vt.available && !us.available) {\n        const score = Math.min(Math.round((vt.score * 0.85) + 10), 100);\n        return { score, method: 'VT_ONLY (URLScan unavailable - single source penalty applied)' };\n    }\n\n    // URLScan only\n    if (!vt.available && us.available) {\n        const score = Math.min(Math.round((us.score * 0.85) + 10), 100);\n        return { score, method: 'URLSCAN_ONLY (VT unavailable - single source penalty applied)' };\n    }\n\n    // Both available - corroborated scoring\n    const maxScore = Math.max(vt.score, us.score);\n    const avgScore = Math.round((vt.score + us.score) / 2);\n\n    if (maxScore >= 70) {\n        return { score: maxScore, method: 'MAX (high-confidence corroborated threat)' };\n    }\n\n    return { score: avgScore, method: 'AVG (consensus - both sources available)' };\n}\n\n// ---------- 5. High-Rep Override ----------\nfunction applyHighRepOverride(currentScore, flaggedVendors, currentMethod) {\n    if (flaggedVendors.length >= 4) {\n        return {\n            score: Math.max(currentScore, 60),\n            method: currentMethod + ' + HIGH_REP_OVERRIDE(critical 4+)',\n        };\n    }\n    if (flaggedVendors.length >= 2) {\n        return {\n            score: Math.max(currentScore, 50),\n            method: currentMethod + ' + HIGH_REP_OVERRIDE(moderate 2+)',\n        };\n    }\n    return { score: currentScore, method: currentMethod };\n}\n\n// ---------- 6. Execute ----------\nconst vt = processVT(vtReport);\nconst us = processURLScan(urlscanData);\nconst flaggedByHighRep = vt.available ? checkHighRepVendors(vt.results) : [];\n\nlet { score: risk_score, method: scoring_method } = computeHybridScore(vt, us);\n\n// Apply high-rep override only if VT data exists\nif (vt.available) {\n    ({ score: risk_score, method: scoring_method } = applyHighRepOverride(risk_score, flaggedByHighRep, scoring_method));\n}\n\n// ---------- 7. Binary Risk Level ----------\nconst risk_level = risk_score >= 50 ? 'HIGH' : 'LOW';\n\n// ---------- 8. Risk Factors ----------\nconst factors = [];\nif (!vt.available) factors.push('VT unavailable');\nif (!us.available) factors.push('URLScan unavailable');\nif (vt.available && vt.vtMalicious > 0) factors.push(`${vt.vtMalicious}/${vt.total} VT engines: malicious`);\nif (vt.available && vt.vtSuspicious > 0) factors.push(`${vt.vtSuspicious} VT engines: suspicious`);\nif (us.available && us.malicious) factors.push('URLScan ML engine: malicious');\nif (us.available && us.score >= 50 && !us.malicious) factors.push(`URLScan score: ${us.score}`);\nif (flaggedByHighRep.length > 0) factors.push(`High-rep vendors: ${flaggedByHighRep.join(', ')}`);\n\nconst risk_factors = factors.length > 0 ? factors.join(' | ') : 'No significant threats detected';\n\n// ---------- 9. Output ----------\nreturn [{\n    json: {\n        url: original.url,\n        risk_score,\n        risk_level,\n        risk_factors,\n        scoring_method,\n        scan_timestamp: original.scan_timestamp,\n        scan_id: original.scan_id,\n\n        vt_available: vt.available,\n        vt_score_raw: vt.score,\n        vt_malicious: vt.vtMalicious,\n        vt_suspicious: vt.vtSuspicious,\n        vt_harmless: vt.vtHarmless,\n        vt_undetected: vt.vtUndetected,\n        vt_result_url: vt.vt_gui_url,\n        vt_detection_ratio: vt.available ? `${vt.vtMalicious}/${vt.total}` : 'N/A',\n        high_rep_vendors_flagged: flaggedByHighRep,\n\n        urlscan_available: us.available,\n        urlscan_score_raw: us.score,\n        urlscan_verdict: !us.available ? 'Unavailable' : us.malicious ? 'Malicious' : 'Clean',\n        urlscan_screenshot: urlscanData?.task?.screenshotURL || '',\n        urlscan_report: urlscanData?.task?.reportURL || '',\n    },\n}];"
      },
