      "parameters": {
        "jsCode": "const body = $input.item.json.body;\nconst query = body.url || body.query || body.ip || '';\n\nconst ipv4Regex = /^(\\d{1,3}\\.){3}\\d{1,3}$/;\nconst ipv6Regex = /^([0-9a-fA-F]{0,4}:){2,7}[0-9a-fA-F]{0,4}$/;\nconst isIP = ipv4Regex.test(query.trim()) || ipv6Regex.test(query.trim());\n\nreturn {\n  json: {\n    ...body,\n    input_value: query,\n    input_type: isIP ? 'ip' : 'url',\n    value_type: isIP ? 'IP' : 'URL',\n    ip: isIP ? query : null,\n    url: !isIP ? query : null,\n    scan_timestamp: new Date().toISOString(),\n    scan_id: Date.now().toString(),\n  }\n};"
